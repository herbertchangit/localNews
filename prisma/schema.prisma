generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADMIN_MEDICAL
  EDITOR
  DOCTOR
  REPORTER
  AUDIENCE
  VOLUNTEER
  DADE
}

enum ArticleStatus {
  DRAFT
  REVIEW
  REVISION
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ResponseCategory {
  UNDERSTANDING
  TOLERANCE
  GRATITUDE
  CONTENTMENT
}

enum HealthAppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  password            String
  name                String
  phone               String?
  stayArea            String?
  avatarUrl           String?
  role                Role                @default(AUDIENCE)
  locked              Boolean             @default(false)
  suspended           Boolean             @default(false)
  permissions         String[]            @default([])
  departmentId        String?
  department          Department?         @relation(fields: [departmentId], references: [id])
  harmonyGroupId      String?
  harmonyGroup        HarmonyGroup?       @relation(fields: [harmonyGroupId], references: [id])
  mutualLoveGroupId   String?
  mutualLoveGroup     MutualLoveGroup?    @relation(fields: [mutualLoveGroupId], references: [id])
  cooperationUnitId   String?
  cooperationUnit     CooperationUnit?    @relation(fields: [cooperationUnitId], references: [id])
  assignedCategories  Category[]          @relation("UserCategories")
  articles            Article[]
  comments            Comment[]
  responses           StoryResponse[]
  photoResponses      PhotoResponse[]
  doctorProfile       DoctorProfile?
  createdHealthEvents HealthEvent[]       @relation("HealthEventCreator")
  patientAppointments HealthAppointment[] @relation("PatientAppointments")
  passkeys            PasskeyCredential[]
  passkeyChallenges   WebAuthnChallenge[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  credentialId String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceType   String?
  backedUp     Boolean  @default(false)
  name         String
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin    String
  rpId      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  archived      Boolean   @default(false)
  articles      Article[]
  assignedUsers User[]    @relation("UserCategories")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model OrgChartEntry {
  id          String   @id @default(cuid())
  harmony     String
  mutualLove  String
  cooperation String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([harmony, mutualLove, cooperation])
}

model HarmonyGroup {
  id          String            @id @default(cuid())
  name        String            @unique
  sortOrder   Int               @default(0)
  mutualLoves MutualLoveGroup[]
  users       User[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MutualLoveGroup {
  id           String            @id @default(cuid())
  name         String
  sortOrder    Int               @default(0)
  harmonyId    String
  harmony      HarmonyGroup      @relation(fields: [harmonyId], references: [id])
  cooperations CooperationUnit[]
  users        User[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([harmonyId, name])
}

model CooperationUnit {
  id           String          @id @default(cuid())
  name         String
  sortOrder    Int             @default(0)
  mutualLoveId String
  mutualLove   MutualLoveGroup @relation(fields: [mutualLoveId], references: [id])
  users        User[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([mutualLoveId, name])
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  excerpt     String
  content     String
  imageUrl    String?
  status      ArticleStatus   @default(DRAFT)
  isBreaking  Boolean         @default(false)
  isTrending  Boolean         @default(false)
  isHeadline  Boolean         @default(false)
  isPublic    Boolean         @default(true)
  views       Int             @default(0)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id])
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  storyDate   DateTime?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  comments    Comment[]
  responses   StoryResponse[]
  photos      ArticlePhoto[]
}

model ArticlePhoto {
  id        String          @id @default(cuid())
  url       String
  caption   String?
  sortOrder Int             @default(0)
  articleId String
  article   Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  responses PhotoResponse[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([articleId, sortOrder])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  approved  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now())
}

model StoryResponse {
  id        String           @id @default(cuid())
  category  ResponseCategory
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, articleId])
  @@index([articleId, category])
}

model PhotoResponse {
  id        String           @id @default(cuid())
  category  ResponseCategory
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId   String
  photo     ArticlePhoto     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, photoId])
  @@index([photoId, category])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model JingSiMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model TranslationMapping {
  source    String   @id
  zhCn      String
  zhTw      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization   String
  qualification    String
  experienceYears  Int                 @default(0)
  bio              String?
  profileImage     String?
  consultationFee  Float               @default(0)
  dutySlots        Json                @default("[]")
  eventAssignments HealthEventDoctor[]
  timeSlots        HealthTimeSlot[]
  appointments     HealthAppointment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model HealthEvent {
  id                    String              @id @default(cuid())
  name                  String
  description           String
  location              String
  address               String
  mapsUrl               String?
  wazeUrl               String?
  eventDate             DateTime
  startTime             String
  endTime               String
  bannerImage           String?
  maxCapacity           Int                 @default(100)
  active                Boolean             @default(true)
  publishedToStoryBoard Boolean             @default(false)
  creatorId             String
  creator               User                @relation("HealthEventCreator", fields: [creatorId], references: [id])
  doctors               HealthEventDoctor[]
  timeSlots             HealthTimeSlot[]
  appointments          HealthAppointment[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model HealthEventDoctor {
  id         String        @id @default(cuid())
  eventId    String
  event      HealthEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  assignedAt DateTime      @default(now())

  @@unique([eventId, doctorId])
}

model HealthTimeSlot {
  id                  String             @id @default(cuid())
  eventId             String
  event               HealthEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  doctorId            String
  doctor              DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startTime           String
  endTime             String
  slotDurationMinutes Int                @default(15)
  booked              Boolean            @default(false)
  appointment         HealthAppointment?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([eventId, doctorId])
}

model HealthAppointment {
  id           String                  @id @default(cuid())
  patientId    String
  patient      User                    @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       DoctorProfile           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  eventId      String
  event        HealthEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotId       String?                 @unique
  slot         HealthTimeSlot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  patientName  String
  patientPhone String?
  startTime    String
  endTime      String
  reason       String?
  status       HealthAppointmentStatus @default(CONFIRMED)
  qrCode       String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([eventId, doctorId])
  @@index([patientId, status])
}
